# TMDB v3 API key or v4 read access token (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Optional: alternate TMDB API base (e.g. a proxy) if your network blocks api.themoviedb.org
# TMDB_API_BASE=https://api.themoviedb.org/3

# Optional: VidCore player accent color, hex without '#'
NEXT_PUBLIC_PLAYER_COLOR=f2b84b
